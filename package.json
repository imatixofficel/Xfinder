{
  "name": "xfinder",
  "version": "2.4.0",
  "private": true,
  "description": "Xfinder Live Node Panel — GitHub Pages + Python collector with real Xray validation",
  "scripts": {
    "dev": "python -m http.server 8000 --directory .",
    "check": "python -m compileall -q src",
    "test": "python -m unittest discover -s tests -v",
    "collect": "python -m src.main",
    "build": "python -m src.main"
  },
  "engines": {
    "node": ">=18"
  }
}
